# Usage:
#   docker build -f Dockerfile.export -t sheet-folio-export .
#   docker run --rm \
#     -e DB_PATH=/data/sheet-folio.db \
#     -e UPLOAD_DIR=/data/uploads \
#     -e OUTPUT_DIR=/output \
#     -v /host/data/app:/data:ro \
#     -v /host/export-data:/output \
#     sheet-folio-export

FROM node:22-slim AS builder
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --frozen-lockfile
RUN pnpm add -D esbuild
COPY scripts/ scripts/
COPY tsconfig.json ./
RUN pnpm exec esbuild scripts/export-data.ts --bundle --platform=node --format=esm \
  --external:better-sqlite3 --external:sharp --outfile=/out/export-data.mjs

FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY --from=builder /out/export-data.mjs .
COPY --from=builder /app/node_modules ./node_modules
ENV DB_PATH=./data/sheet-folio.db
ENV UPLOAD_DIR=./data/uploads
ENV OUTPUT_DIR=./export-data
ENTRYPOINT ["node", "export-data.mjs"]